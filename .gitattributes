# Auto detect text files and normalize line endings
* text=auto

# Explicitly declare text file types
*.html text
*.css text
*.js text
*.md text
*.xml text
*.txt text
*.json text

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.woff binary
*.woff2 binary
